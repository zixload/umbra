{
  "manifest_version": 3,
  "name": "Umbra Blocker",
  "version": "1.0.4",
  "description": "Blocks distracting websites while Umbra focus protection is active.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": "",
  "permissions": ["nativeMessaging", "declarativeNetRequest", "webNavigation", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Umbra Blocker",
    "default_popup": "popup.html"
  },
  "background": { "service_worker": "background.js" },
  "web_accessible_resources": [{
    "resources": ["blocked.html", "blocked.css"],
    "matches": ["<all_urls>"]
  }]
}
