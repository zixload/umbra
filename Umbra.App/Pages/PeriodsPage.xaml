<UserControl x:Class="Umbra.App.Pages.PeriodsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <!-- Défini aussi ici (pas seulement dans FocusPage.xaml qui héberge
             cette page) : StaticResource se résout au moment du chargement
             du XAML de CE fichier, pas via l'arbre visuel d'exécution -
             contrairement aux clés DynamicResource internes de WPF-UI
             (CornerRadius etc.) qui, elles, traversent bien la frontière
             parent/enfant à l'affichage. Sans ça : XamlParseException au
             lancement ("Cannot find resource named 'SectionHeaderStyle'"). -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#40BDFF" />
        </Style>
    </UserControl.Resources>
    <Grid MaxWidth="1100">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Basé sur History.GetSuggestedStartHour (heure de début la plus
             fréquente sur les 30 derniers jours) - masqué si l'utilisateur
             a déjà ignoré cette heure précise (Settings.DismissedSuggestedHour)
             ou si une plage la couvre déjà. Voir PeriodsPage.xaml.cs.RenderSuggestion. -->
        <ui:CardControl x:Name="SuggestionCard" Grid.Row="0" Margin="0,0,0,8" Visibility="Collapsed">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Lightbulb24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <TextBlock x:Name="SuggestionText" TextWrapping="Wrap" VerticalAlignment="Center" />
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:Button x:Name="SuggestionCreateButton" Appearance="Primary" Margin="0,0,8,0" Click="SuggestionCreate_Click" />
                <ui:Button x:Name="SuggestionDismissButton" Appearance="Secondary" Click="SuggestionDismiss_Click" />
            </StackPanel>
        </ui:CardControl>

        <ui:CardExpander x:Name="NewPeriodExpander" Grid.Row="1" IsExpanded="True" Margin="0,0,0,8">
            <StackPanel MinWidth="500">
                <ui:TextBox x:Name="NameBox" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock x:Name="StartLabel" Opacity="0.6" VerticalAlignment="Center" Width="50" />
                    <ui:TextBox x:Name="StartBox" Width="80" Text="22:00" />
                    <TextBlock x:Name="EndLabel" Opacity="0.6" VerticalAlignment="Center" Width="50" Margin="16,0,0,0" />
                    <ui:TextBox x:Name="EndBox" Width="80" Text="07:00" />
                </StackPanel>
                <TextBlock x:Name="DaysLabel" FontSize="12" Opacity="0.6" Margin="0,0,0,8" />
                <StackPanel x:Name="DaysPanel" Orientation="Horizontal" Margin="0,0,0,10" />
                <TextBlock x:Name="BlocklistLabel" FontSize="12" Opacity="0.6" Margin="0,0,0,8" />
                <ComboBox x:Name="BlocklistCombo" HorizontalAlignment="Left" MinWidth="200" Margin="0,0,0,10" />
                <DockPanel Margin="0,0,0,14" LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <ui:SymbolIcon Symbol="LockClosed24" Margin="0,0,8,0" />
                        <StackPanel>
                            <TextBlock x:Name="HardModeLabel" VerticalAlignment="Center" />
                            <TextBlock x:Name="HardModeDescText" FontSize="12" Opacity="0.6" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="HardModeToggle" DockPanel.Dock="Right" />
                </DockPanel>
                <DockPanel Margin="0,0,0,14" LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <ui:SymbolIcon Symbol="Timer24" Margin="0,0,8,0" />
                        <StackPanel>
                            <TextBlock x:Name="PomodoroModeLabel" VerticalAlignment="Center" />
                            <TextBlock x:Name="PomodoroModeDescText" FontSize="12" Opacity="0.6" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="PomodoroModeToggle" DockPanel.Dock="Right" />
                </DockPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:Button x:Name="AddPeriodButton" Appearance="Primary" HorizontalAlignment="Left" Click="AddPeriod_Click" />
                    <!-- Visible seulement en train de modifier une plage
                         existante (voir StartEditing/ResetForm) - revient au
                         formulaire "nouvelle plage" sans rien enregistrer. -->
                    <ui:Button x:Name="CancelEditButton" Appearance="Secondary" Margin="8,0,0,0" Visibility="Collapsed" Click="CancelEdit_Click" />
                </StackPanel>
            </StackPanel>
        </ui:CardExpander>

        <StackPanel Grid.Row="2">
            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PeriodsList" />
            </ScrollViewer>
        </StackPanel>
    </Grid>
</UserControl>
